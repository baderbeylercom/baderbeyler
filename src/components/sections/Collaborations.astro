---
import { getSiteData } from '../../lib/site-data';

const { collaborationsContent } = await getSiteData();
const items = collaborationsContent.items;

function short(text: string, n = 120) {
  return text.length > n ? text.slice(0, n).trimEnd() + '…' : text;
}
---

<section class="section collaborations snap-section" id="collaborations">
  <div class="reveal">
    <p class="section-tag">{collaborationsContent.eyebrow}</p>
    <h2 class="section-title" set:html={collaborationsContent.title}></h2>
  </div>

  <div class="collab-panels reveal">
    {
      items.map((item, index) => (
        <article
          class="collab-panel"
          style={`--ac:${item.accent ?? '#c0954e'};--ac2:${item.accent2 ?? '#e4c078'}`}
          tabindex="0"
          role="button"
          aria-label={`${item.partnerName} — detaylar`}
          data-collab-open={`collab-modal-${index}`}
        >
          <img
            class="cp-photo"
            src={item.image}
            alt={item.imageAlt ?? item.partnerName}
            loading="lazy"
            draggable="false"
          />
          <div class="cp-scrim" aria-hidden="true"></div>
          <div class="cp-min">
            <span class="cp-brand">{item.brandLine}</span>
            <span class="cp-name">{item.partnerName}</span>
          </div>
          <div class="cp-full">
            <span class="cp-brand">{item.brandLine}</span>
            <h3 class="cp-name-lg">{item.partnerName}</h3>
            <p class="cp-desc">
              {item.leadStrong && <strong>{item.leadStrong}</strong>}
              {short(item.leadText)}
            </p>
            <span class="cp-cta">Hakkında →</span>
          </div>
        </article>
      ))
    }
  </div>
</section>

{collaborationsContent.items.map((item, index) => (
  <div class="collab-modal" id={`collab-modal-${index}`} role="dialog" aria-modal="true">
    <div class="collab-modal-backdrop"></div>
    <div class="collab-modal-content" style={`--ac:${item.accent ?? '#c0954e'}`}>
      <button class="collab-modal-close" aria-label="Kapat">&#x2715;</button>
      {item.image && (
        <div class="collab-modal-cover">
          <img src={item.image} alt={item.imageAlt ?? item.partnerName ?? ''} />
          <div class="collab-modal-cover-overlay"></div>
        </div>
      )}
      <div class="collab-modal-body">
        <p class="collab-modal-brand">{item.brandLine}</p>
        <h3 class="collab-modal-name">{item.partnerName}</h3>
        <p class="collab-modal-lead">
          {item.leadStrong && <strong>{item.leadStrong}</strong>}
          {item.leadText}
        </p>
        {item.description && <p class="collab-modal-desc">{item.description}</p>}
      </div>
    </div>
  </div>
))}

<style>
  .collab-panels {
    display: flex;
    gap: 0.7rem;
    height: min(52vh, 430px);
    margin-top: 2.4rem;
  }

  .collab-panel {
    position: relative;
    flex: 1;
    min-width: 0;
    border-radius: 20px;
    overflow: hidden;
    cursor: pointer;
    background:
      radial-gradient(46% 50% at 50% 44%, rgba(174, 158, 138, 0.24), transparent 68%),
      linear-gradient(165deg, #f1ece3, #e6dccd);
    box-shadow: inset 0 0 0 1px rgba(255, 255, 255, 0.55);
    transition: flex 0.6s cubic-bezier(0.19, 1, 0.22, 1);
    outline: none;
  }

  .cp-photo {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: contain;
    object-position: center bottom;
    filter: grayscale(0.12);
    transition: filter 0.6s, transform 0.8s cubic-bezier(0.19, 1, 0.22, 1);
  }

  .cp-scrim {
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, transparent 56%, rgba(233, 224, 211, 0.5) 80%, rgba(233, 224, 211, 0.9));
  }

  .cp-min {
    position: absolute;
    inset: auto 0 0;
    padding: 1.4rem 1.5rem;
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
    transition: opacity 0.4s;
  }

  .cp-brand {
    font-size: 0.68rem;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: color-mix(in srgb, var(--ac) 74%, #35291a);
  }

  .cp-min .cp-name {
    font-family: var(--font-serif);
    font-weight: 600;
    font-size: 1.35rem;
    color: var(--clr-deep, #2e3a44);
    line-height: 1.14;
  }

  .cp-full {
    position: absolute;
    inset: auto 0 0;
    padding: 1.7rem 1.9rem;
    max-width: 540px;
    opacity: 0;
    transform: translateY(14px);
    transition: opacity 0.5s 0.1s, transform 0.5s 0.1s;
    pointer-events: none;
  }

  .cp-name-lg {
    font-family: var(--font-serif);
    font-weight: 600;
    font-size: 1.75rem;
    color: var(--clr-deep, #2e3a44);
    margin: 0.2rem 0 0.55rem;
    line-height: 1.12;
  }

  .cp-desc {
    font-size: 0.9rem;
    color: #4a413a;
    margin: 0 0 1rem;
    line-height: 1.55;
  }

  .cp-desc strong {
    color: var(--clr-deep, #2e3a44);
    font-weight: 600;
  }

  .cp-cta {
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--clr-deep, #2e3a44);
    border: 1px solid rgba(46, 58, 68, 0.4);
    padding: 0.5rem 1.1rem;
    border-radius: 999px;
    display: inline-block;
    transition: background 0.3s, border-color 0.3s, color 0.3s;
  }

  .collab-panel::after {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    height: 3px;
    background: var(--ac);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 0.6s;
  }

  .collab-panels:hover .collab-panel {
    flex: 0.68;
  }
  .collab-panels:hover .cp-min {
    opacity: 0;
  }
  .collab-panels:hover .collab-panel:hover,
  .collab-panel:focus-visible {
    flex: 2.5;
  }
  .collab-panel:hover .cp-photo,
  .collab-panel:focus-visible .cp-photo {
    filter: grayscale(0);
  }
  .collab-panel:hover .cp-min,
  .collab-panel:focus-visible .cp-min {
    opacity: 0;
  }
  .collab-panel:hover .cp-full,
  .collab-panel:focus-visible .cp-full {
    opacity: 1;
    transform: translateY(0);
    pointer-events: auto;
  }
  .collab-panel:hover .cp-cta,
  .collab-panel:focus-visible .cp-cta {
    background: var(--ac);
    border-color: var(--ac);
    color: #fff;
  }
  .collab-panel:hover::after,
  .collab-panel:focus-visible::after {
    transform: scaleX(1);
  }

  /* ── Mobil: dikey istifleme, dokun → modal ── */
  @media (max-width: 768px) {
    .collab-panels {
      flex-direction: column;
      height: auto;
      gap: 0.7rem;
      margin-top: 1.4rem;
    }
    .collab-panel {
      height: 230px;
      flex: none !important;
    }
    .cp-photo {
      object-fit: cover;
      object-position: center 16%;
    }
    .cp-scrim {
      background: linear-gradient(180deg, transparent 40%, rgba(20, 26, 32, 0.82));
    }
    .cp-brand {
      color: var(--ac2);
    }
    .cp-min .cp-name {
      color: #fff;
      font-size: 1.28rem;
    }
    .cp-full {
      display: none;
    }
    .cp-min {
      opacity: 1 !important;
    }
    .collab-panel::after {
      display: none;
    }
  }

  /* ── Modal ── */
  .collab-modal {
    display: none;
    position: fixed;
    inset: 0;
    z-index: 9999;
    align-items: flex-end;
    justify-content: center;
  }
  .collab-modal.open {
    display: flex;
  }
  .collab-modal-backdrop {
    position: absolute;
    inset: 0;
    background: rgba(0, 0, 0, 0.6);
    cursor: pointer;
  }
  .collab-modal-content {
    position: relative;
    z-index: 1;
    background: #f5f3ef;
    border-radius: 1.25rem 1.25rem 0 0;
    width: 100%;
    max-width: 560px;
    max-height: 90vh;
    overflow-y: auto;
    transform: translateY(100%);
    transition: transform 0.38s cubic-bezier(0.22, 1, 0.36, 1);
  }
  .collab-modal.open .collab-modal-content {
    transform: translateY(0);
  }
  @media (min-width: 769px) {
    .collab-modal {
      align-items: center;
    }
    .collab-modal-content {
      border-radius: 1.25rem;
      transform: translateY(24px) scale(0.97);
    }
    .collab-modal.open .collab-modal-content {
      transform: translateY(0) scale(1);
    }
  }
  .collab-modal-close {
    position: absolute;
    top: 0.9rem;
    right: 1.1rem;
    z-index: 2;
    background: rgba(255, 255, 255, 0.7);
    border: none;
    border-radius: 50%;
    width: 2rem;
    height: 2rem;
    font-size: 1rem;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    color: #333;
    backdrop-filter: blur(4px);
  }
  .collab-modal-cover {
    position: relative;
    width: 100%;
    height: min(60vw, 340px);
    overflow: hidden;
    border-radius: 1.25rem 1.25rem 0 0;
    background: linear-gradient(160deg, color-mix(in srgb, var(--ac) 14%, #f5f3ef), #f5f3ef);
  }
  .collab-modal-cover img {
    width: 62%;
    height: 100%;
    object-fit: cover;
    object-position: center top;
    display: block;
    margin: 0 auto;
  }
  .collab-modal-cover-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(to bottom, transparent 45%, rgba(245, 243, 239, 0.92) 100%);
  }
  .collab-modal-body {
    padding: 1.5rem 1.6rem 2.4rem;
  }
  .collab-modal-brand {
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--ac);
    margin-bottom: 0.25rem;
  }
  .collab-modal-name {
    font-family: var(--font-serif);
    font-size: clamp(1.5rem, 4.5vw, 2rem);
    font-weight: 700;
    color: var(--clr-deep);
    line-height: 1.2;
    margin-bottom: 1rem;
  }
  .collab-modal-lead {
    font-size: 0.94rem;
    line-height: 1.75;
    color: #2e231d;
  }
  .collab-modal-lead strong {
    color: var(--clr-deep);
  }
  .collab-modal-desc {
    font-size: 0.9rem;
    line-height: 1.7;
    opacity: 0.75;
    margin-top: 0.75rem;
  }
</style>

<script>
  function openCollabModal(id: string) {
    const modal = document.getElementById(id);
    if (!modal) return;
    modal.classList.add('open');
    document.body.style.overflow = 'hidden';
  }

  function closeCollabModal(modal: HTMLElement) {
    modal.classList.remove('open');
    (document.body.style as any).overflow = '';
  }

  document.querySelectorAll<HTMLElement>('.collab-panel[data-collab-open]').forEach((panel) => {
    const id = panel.getAttribute('data-collab-open')!;
    panel.addEventListener('click', () => openCollabModal(id));
    panel.addEventListener('keydown', (e) => {
      if (e.key === 'Enter' || e.key === ' ') {
        e.preventDefault();
        openCollabModal(id);
      }
    });
  });

  document.querySelectorAll<HTMLElement>('.collab-modal').forEach((modal) => {
    modal.querySelector('.collab-modal-backdrop')?.addEventListener('click', () => closeCollabModal(modal));
    modal.querySelector('.collab-modal-close')?.addEventListener('click', () => closeCollabModal(modal));
  });

  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') {
      const open = document.querySelector<HTMLElement>('.collab-modal.open');
      if (open) closeCollabModal(open);
    }
  });
</script>
